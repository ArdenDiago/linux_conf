{
  // v7 theme by atif-1402 (github.com/atif-1402/minimal-waybar-themes),
  // Omarchy modules swapped for plain-Arch equivalents.
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 46,
  "border-radius": 25,
  "margin-right": 10,
  "margin-left": 10,
  "margin-top": 2,
  "modules-left": [ ],
  "modules-center": [ "group/center4", "group/center3", "hyprland/workspaces", "group/center2" ],
  "modules-right": [ ],

  "group/center2": {
    "orientation": "inherit",
    "modules": [
      "custom/clock",
      "custom/separator#blank",
      "custom/separator#blank",
      "custom/separator#blank",
      "custom/separator#blank",
      "cpu",
      "memory"
    ]
  },

  "group/center3": {
    "orientation": "inherit",
    "modules": [
      "custom/separator#blank",
      "custom/gamemode",
      "custom/update",
      "custom/separator#dot",
      "custom/separator#blank",
      "custom/media-prev",
      "custom/media-playpause",
      "custom/media-next",
      "custom/media-spectrum"
    ]
  },

  "group/center4": {
    "orientation": "inherit",
    "modules": [
      "custom/launcher",
      "custom/active_window",
      "custom/separator#blank",
      "custom/separator#dot",
      "tray",
      "network",
      "bluetooth"
    ]
  },

  "custom/active_window": {
    "exec": "~/.config/waybar/window-hyprland.sh",
    "return-type": "json",
    "markup": true
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1":  "<span size='13500'>󰲠</span>",
      "2":  "<span size='13500'>󰲢</span>",
      "3":  "<span size='13500'>󰲤</span>",
      "4":  "<span size='13500'>󰲦</span>",
      "5":  "<span size='13500'>󰲨</span>",
      "6":  "<span size='13500'>󰲪</span>",
      "7":  "<span size='13500'>󰲬</span>",
      "8":  "<span size='13500'>󰲮</span>",
      "9":  "<span size='13500'>󰲰</span>",
      "10": "<span size='13500'>󰿬</span>"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": []
    }
  },

  "custom/launcher": {
    "format": "<span size='11500'>󰀻</span>",
    "on-click": "fuzzel",
    "tooltip-format": "Launcher (Super+D)"
  },

  "cpu": {
    "interval": 2,
    "format": "{icon} ",
    "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "on-click": "alacritty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": "{icon} ",
    "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "on-click": "alacritty -e btop"
  },

  "custom/clock": {
    "exec": "~/.config/waybar/clock.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": false
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "<span size='11500'>󰌘</span>",
    "format-disconnected": "<span size='11500'>󰤮</span>",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "~/.config/waybar/network-menu.sh"
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "bluetooth": {
    "format": "<span size='11500'>󰂯</span>",
    "format-disabled": "<span size='11500'>󰂲</span>",
    "format-connected": "<span size='11500'></span>",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "~/.config/waybar/bluetooth-menu.sh"
  },

  "pulseaudio": {
    "format": "<span size='11500'>{icon}</span>",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": [" ", " ", " "]
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/media-prev": {
    "exec": "~/.config/waybar/media-button.sh prev",
    "on-click": "playerctl previous",
    "return-type": "json",
    "interval": 1
  },

  "custom/media-playpause": {
    "exec": "~/.config/waybar/media-button.sh playpause",
    "on-click": "playerctl play-pause",
    "return-type": "json",
    "interval": 1
  },

  "custom/media-next": {
    "exec": "~/.config/waybar/media-button.sh next",
    "on-click": "playerctl next",
    "return-type": "json",
    "interval": 1
  },

  "custom/media-spectrum": {
    "exec": "~/.config/waybar/media-spectrum.py",
    "return-type": "json",
    "on-click": "~/.config/waybar/media-boost-toggle.sh"
  },

  "custom/separator#blank": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },

  "custom/separator#dot": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },

  "custom/update": {
    "exec": "~/.config/waybar/update.sh",
    "return-type": "json",
    "on-click": "alacritty -e sudo pacman -Syu",
    "signal": 7,
    "interval": 21600
  },

  "custom/gamemode": {
    "exec": "test -f ~/.cache/hypr_gamemode && echo '{\"text\":\"\"}' || echo '{\"text\":\"\"}'",
    "on-click": "test -f ~/.cache/hypr_gamemode && (rm ~/.cache/hypr_gamemode && hyprctl keyword animations:enabled 1 && hyprctl keyword decoration:blur:enabled 1) || (touch ~/.cache/hypr_gamemode && hyprctl keyword animations:enabled 0 && hyprctl keyword decoration:blur:enabled 0)",
    "interval": 1,
    "return-type": "json",
    "tooltip": true,
    "tooltip-format": "GameMode"
  }
}
